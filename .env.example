# Postgres connection string. On Neon, use the *pooled* connection string
# (the host contains "-pooler").
DATABASE_URL=

# "Today" for every time-based rule (segments, the assistant). The assessment
# fixes it at 2026-09-28. Remove the line to use the real clock.
CDP_TODAY=2026-09-28

# The shared password for the UI login gate.
APP_PASSWORD=

# A long random string that signs the login session cookie. Generate one with
# `openssl rand -base64 32`. Changing it signs everyone out.
AUTH_SECRET=

# Google Gemini API key for the assistant. A free key comes from Google AI Studio
# (aistudio.google.com). On the free tier Google may use requests to improve its
# products; the assistant never sends personal data.
GEMINI_API_KEY=

# Optional: which Gemini models to use, comma-separated, tried in order when a
# model's free quota runs out. Leave blank for the defaults.
GEMINI_MODEL=
